/// Province, name, region, CBA region and the REAL arrears factor (region arrears rate / Canada).
table dim_province
	lineageTag: 0e267054-14fc-5856-8f7b-b3d996248d0a

	column province
		dataType: string
		lineageTag: cd4acf82-9ab6-5c92-a17b-639c8d29f4da
		summarizeBy: none
		sourceColumn: province

		annotation SummarizationSetBy = User

	column province_name
		dataType: string
		lineageTag: 1bc60908-14d9-5087-9c65-5c87e291f1b0
		dataCategory: StateOrProvince
		summarizeBy: none
		sourceColumn: province_name

		annotation SummarizationSetBy = User

	column region
		dataType: string
		lineageTag: d2ba379a-a855-5cdf-b6ae-911bc115fe70
		summarizeBy: none
		sourceColumn: region

		annotation SummarizationSetBy = User

	column cba_region
		dataType: string
		lineageTag: 276356f3-067f-5bfc-b3b3-b0259ccda787
		summarizeBy: none
		sourceColumn: cba_region

		annotation SummarizationSetBy = User

	column real_arrears_factor
		dataType: double
		lineageTag: 0beded91-3c52-50ef-b802-6c16d50fb037
		summarizeBy: none
		sourceColumn: real_arrears_factor

		annotation SummarizationSetBy = User

	partition dim_province = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "dim_province.csv"), [Delimiter = ",", Columns = 5, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    // Empty cells mean 'no value' (e.g. real arrears not yet published, future-month rates)
				    BlanksToNull = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, Table.ColumnNames(Promoted)),
				    Typed = Table.TransformColumnTypes(BlanksToNull, {{"province", type text}, {"province_name", type text}, {"region", type text}, {"cba_region", type text}, {"real_arrears_factor", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

