	partition fact_renewal = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_renewal.csv"), [Delimiter = ",", Columns = 31, Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    // Empty cells mean 'no value' (e.g. real arrears not yet published, future-month rates)
				    BlanksToNull = Table.ReplaceValue(Promoted, "", null, Replacer.ReplaceValue, Table.ColumnNames(Promoted)),
				    Typed = Table.TransformColumnTypes(BlanksToNull, {{"product", type text}, {"loan_id", Int64.Type}, {"province", type text}, {"credit_band", type text}, {"credit_score", Int64.Type}, {"renewal_month", type date}, {"renewal_year", Int64.Type}, {"already_renewed", type logical}, {"old_rate", type number}, {"new_rate", type number}, {"rate_jump_pp", type number}, {"balance_at_renewal", Currency.Type}, {"old_payment", Currency.Type}, {"new_payment", Currency.Type}, {"payment_increase", Currency.Type}, {"annual_payment_increase", Currency.Type}, {"payment_shock_pct", type number}, {"shock_band", type text}, {"is_severe_shock", type logical}, {"has_defaulted", type logical}, {"new_rate_source", type text}, {"source", type text}, {"region_factor", type number}, {"base_pd_12m", type number}, {"stressed_pd_12m", type number}, {"loss_given_default", type number}, {"expected_loss_before", Currency.Type}, {"expected_loss_after", Currency.Type}, {"incremental_provision", Currency.Type}, {"can_contact", type logical}, {"outreach_priority", Int64.Type}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

