{
  "name": "Credit Risk",
  "dataColors": [
    "#1F3A5F",
    "#6B7A90",
    "#B8C2D1",
    "#3E5C76",
    "#8C9BAB",
    "#2B4A6F",
    "#A3AEBD",
    "#5A6F87"
  ],
  "good": "#2E7D32",
  "neutral": "#6B7A90",
  "bad": "#9B2226",
  "maximum": "#9B2226",
  "center": "#E3B5B5",
  "minimum": "#FFFFFF",
  "foreground": "#1E2433",
  "foregroundNeutralSecondary": "#5F6B7D",
  "background": "#FFFFFF",
  "backgroundLight": "#F4F5F7",
  "backgroundNeutral": "#E4E7EC",
  "tableAccent": "#1F3A5F",
  "textClasses": {
    "callout": {
      "fontSize": 22,
      "fontFace": "Segoe UI Semibold",
      "color": "#1E2433"
    },
    "title": {
      "fontSize": 11,
      "fontFace": "Segoe UI Semibold",
      "color": "#1E2433"
    },
    "header": {
      "fontSize": 10,
      "fontFace": "Segoe UI Semibold",
      "color": "#1E2433"
    },
    "label": {
      "fontSize": 9,
      "fontFace": "Segoe UI",
      "color": "#5F6B7D"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "title": [
          {
            "show": true,
            "fontColor": {
              "solid": {
                "color": "#1E2433"
              }
            },
            "fontSize": 11,
            "fontFamily": "Segoe UI Semibold",
            "titleWrap": true
          }
        ],
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E4E7EC"
              }
            },
            "radius": 8,
            "width": 1
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "padding": [
          {
            "top": 10,
            "bottom": 8,
            "left": 12,
            "right": 12
          }
        ],
        "valueAxis": [
          {
            "showAxisTitle": false,
            "gridlineStyle": "dotted",
            "gridlineColor": {
              "solid": {
                "color": "#DDE1E7"
              }
            }
          }
        ],
        "categoryAxis": [
          {
            "showAxisTitle": false,
            "gridlineShow": false
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F4F5F7"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F4F5F7"
              }
            },
            "transparency": 0
          }
        ]
      }
    },
    "card": {
      "*": {
        "labels": [
          {
            "color": {
              "solid": {
                "color": "#1F3A5F"
              }
            },
            "fontSize": 22,
            "fontFamily": "Segoe UI Semibold"
          }
        ],
        "categoryLabels": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#5F6B7D"
              }
            },
            "fontSize": 10
          }
        ]
      }
    },
    "lineChart": {
      "*": {
        "lineStyles": [
          {
            "strokeWidth": 2,
            "showMarker": false
          }
        ]
      }
    },
    "tableEx": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#1F3A5F"
              }
            }
          }
        ],
        "grid": [
          {
            "gridVertical": false,
            "rowPadding": 3
          }
        ]
      }
    },
    "pivotTable": {
      "*": {
        "columnHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "backColor": {
              "solid": {
                "color": "#1F3A5F"
              }
            }
          }
        ],
        "rowHeaders": [
          {
            "fontColor": {
              "solid": {
                "color": "#1E2433"
              }
            }
          }
        ]
      }
    }
  }
}