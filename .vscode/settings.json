{
  "python.defaultInterpreterPath": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
  "python.terminal.activateEnvironment": true,
  // Run Jupyter cells from the project folder, so "config/pipeline.yml" and
  // "data/..." paths work the same as when running a script from the terminal
  "jupyter.notebookFileRoot": "${workspaceFolder}",
  "terminal.integrated.env.windows": {
    // numpy's OpenBLAS reserves a buffer per thread at import (16 on this
    // machine) and crashed when memory was tight. Our work is pandas, not
    // matrix maths, so 4 threads costs nothing.
    "OPENBLAS_NUM_THREADS": "4"
  },
  "files.eol": "\n",
  "files.exclude": {
    "**/__pycache__": true,
    ".pytest_cache": true
  }
}
