{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Bootstrap (check environment)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/bootstrap.py",
      "cwd": "${workspaceFolder}",
      // OPENBLAS_NUM_THREADS: see the note in settings.json
      "env": { "PYTHONPATH": "${workspaceFolder}/src", "OPENBLAS_NUM_THREADS": "4" },
      "console": "integratedTerminal"
    }
  ]
}
