{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Bootstrap (check environment)",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
      "args": ["scripts\\bootstrap.py"],
      "options": {
        "cwd": "${workspaceFolder}",
        // OPENBLAS_NUM_THREADS: see the note in settings.json
        "env": { "PYTHONPATH": "${workspaceFolder}\\src", "OPENBLAS_NUM_THREADS": "4" }
      },
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": []
    }
  ]
}
